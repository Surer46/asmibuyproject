{
  "name": "asmibuy-backend",
  "version": "2.1.0",
  "description": "API REST Backend para Asmibuy MVP en Express y TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node copiar-migraciones.js",
    "start": "tsc && node copiar-migraciones.js && node dist/index.js",
    "dev": "node --watch --loader ts-node/esm src/index.ts",
    "migrate": "tsc && node copiar-migraciones.js && node dist/migrations/migrador.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
