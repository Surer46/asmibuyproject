# =========================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — ASMIBUY BACKEND API (SPEC v2.1)
# Copia este archivo como .env en app/backend/ (o crea un enlace simbólico)
# NUNCA agregues contraseñas reales ni cadenas con secretos al repositorio.
# =========================================================================

# Puerto del servidor Express
PORT=3001
NODE_ENV=development

# Conexión obligatoria a PostgreSQL (Supabase Free o PostgreSQL local)
# Nota: La base de datos es obligatoria para autenticación, inventario y ventas.
# No existe almacenamiento silencioso en memoria fuera de pruebas unitarias.
DATABASE_URL=postgresql://postgres:tu_password_segura@db.tu_proyecto.supabase.co:5432/postgres

# Secreto para firma y validación de cookies de sesión
SESSION_SECRET=asmibuy_secreto_seguro_sesiones_2026_grupo_4c

# Orígenes autorizados para CORS y validación de cabecera Origin en CSRF
# Soporta lista separada por comas (ej. desarrollo local y frontend web)
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3001
CORS_ORIGIN=http://localhost:4200

# IP real del cliente detrás de un proxy o balanceador (Render, Nginx, Cloudflare...).
# Vacío o false en local. En el despliegue, el número de proxies delante de la API (normalmente 1)
# o una lista de subredes de confianza. No usar "true": permite falsificar X-Forwarded-For.
TRUST_PROXY=
# Fallos de login permitidos por IP antes de bloquearla (por defecto 20). El límite por
# IP + correo sigue en 5; este valor mayor evita que una caja bloquee a las demás de la sucursal.
LOGIN_MAX_INTENTOS_IP=20

# Verificación de certificados SSL en conexiones PostgreSQL
# Por defecto se verifica el certificado para evitar ataques de intermediario (MITM).
# Para un CA propio (p. ej. el certificado de Supabase: Database Settings → SSL), DB_SSL_CA recibe
# el CONTENIDO PEM del certificado, no una ruta de archivo. En .env escríbelo en una sola línea
# reemplazando cada salto de línea por \n:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
DB_SSL_REJECT_UNAUTHORIZED=true

# Zona IANA del negocio para días civiles del historial; no usar la zona del navegador.
BUSINESS_TIME_ZONE=America/Mexico_City
# TEST_DATABASE_URL se suministra solo a los scripts de prueba: base LOCAL desechable asmibuy_test_*.
# Nunca reutilizar DATABASE_URL operativa ni registrar su valor en evidencias.
