# =========================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — ASMIBUY BACKEND API (SPEC v2.1)
# Copia este archivo como .env en app/backend/ (o crea un enlace simbólico)
# NUNCA agregues contraseñas reales ni cadenas con secretos al repositorio.
# =========================================================================

# Puerto del servidor Express
PORT=3001
NODE_ENV=development

# Conexión obligatoria a PostgreSQL (Supabase Free o PostgreSQL local)
# Nota: La base de datos es obligatoria para autenticación, inventario y ventas.
# No existe almacenamiento silencioso en memoria fuera de pruebas unitarias.
DATABASE_URL=postgresql://postgres:tu_password_segura@db.tu_proyecto.supabase.co:5432/postgres

# Secreto para firma y validación de cookies de sesión
SESSION_SECRET=asmibuy_secreto_seguro_sesiones_2026_grupo_4c

# Orígenes autorizados para CORS y validación de cabecera Origin en CSRF
# Soporta lista separada por comas (ej. desarrollo local y frontend web)
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:3001
CORS_ORIGIN=http://localhost:4200

# Verificación de certificados SSL en conexiones PostgreSQL
# Por defecto se verifica el certificado para evitar ataques de intermediario (MITM).
# Para certificados autofirmados o de prueba, se puede indicar la ruta del CA con DB_SSL_CA.
DB_SSL_REJECT_UNAUTHORIZED=true
